set_pin_assignment { rgmii_rxd[3] } { LOCATION=N9; IOSTANDARD=LVCMOS33; PULLTYPE=NONE; }
set_pin_assignment { rgmii_txc } { LOCATION=T12; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=16; SLEWRATE=FAST; PULLTYPE=NONE; OUTDEL=3; }
set_pin_assignment { rgmii_tx_ctl } { LOCATION=T7; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=16; SLEWRATE=FAST; PULLTYPE=NONE; }
